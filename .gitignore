# Node dependencies & lockfiles
node_modules/
package-lock.json

# Build output & packages
dist/
*.zip

# Test reports & coverage
coverage/
.nyc_output/
playwright-report/
test-results/
.playwright/

# Generated screenshots. 6 MB of PNGs regenerated by `npm run preview` on
# demand; only the published subset in assets/screenshots/ is tracked.
hamsoo-addon/preview-shots/

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak

# Environment & local overrides
.env
.env.local
.env.*.local
*.pem

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo

# Internal release instructions & store listings
RELEASE-*.md
/STORE-LISTING.md
/HAMSOO-*.md

# Internal release instructions stay private, but docs/DEBUGGING-REPORT.md is
# published on purpose: source comments and CONTRIBUTING.md cite its R-numbers,
# so ignoring the whole docs/ directory left those references pointing at a file
# nobody outside the repo could open.
docs/**/*.internal.md

# Scratch images & scripts. Every pattern here is anchored with a leading slash:
# unanchored, `with-hamsoo.jpg` also matched
# hamsoo-addon/website/images/with-hamsoo.jpg, so two images inside the directory
# pages.yml publishes were excluded from the site. Keep these root-only.
/with-hamsoo.jpg
/without-hamsoo.jpg
/*-labeled.jpg
/hamsoo-comparison-split.jpg
/image*.png
/process_images.py



# Internal testing & development tooling (never published).
# The PUBLISHED test suite lives in hamsoo-addon/test/ and hamsoo-addon/scripts/
# and must stay tracked -- do not add those here.
dev/
audit-harness/
audit2/
*.mjs.log
